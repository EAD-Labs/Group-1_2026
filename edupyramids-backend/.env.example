# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edupyramids_dev
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-anything-leaves-localhost
JWT_EXPIRY=7d

# School authentication API.
#
# HLD Section 7.3 calls this the school authentication API, and decision D-02
# keeps this phase clear of the Spoken Tutorial platform APIs, so the variable is
# named for the school rather than for Spoken Tutorial.
#
# Left blank on purpose: with no URL set the server verifies passwords against
# its own users table and logs that it is doing so. Set both values once the
# client supplies them (Week 3 blocker, HLD Section 15).
# Spoken Tutorial's own credential check, from spoken-website/api/views.py:
#   POST { email, password } -> 200 success | 401 wrong | 403 disabled
# Set this to their deployment, for example:
#   SCHOOL_AUTH_URL=https://spoken-tutorial.org/api/spoken-social/verify-user/
SCHOOL_AUTH_URL=
# Only if they put the endpoint behind a key. Their code does not require one.
SCHOOL_AUTH_API_KEY=

# Frontend origin, used for CORS.
# Vite serves on 5173. Setting this to 3000 blocks every browser request.
FRONTEND_URL=http://localhost:5173

# Failed-login throttle (HLD test A2: the sixth try in a row is blocked)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# The client's school database, read only.
#
# A separate database on purpose: EduPyramids owns no tables in it and writes
# nothing to it. Leave SCHOOL_DB_NAME blank and the app runs without it.
SCHOOL_DB_HOST=127.0.0.1
SCHOOL_DB_PORT=5432
SCHOOL_DB_NAME=school_db
SCHOOL_DB_USER=postgres
SCHOOL_DB_PASSWORD=
