# Copy to .env next to docker-compose.yml (cp .env.docker.example .env), then
# fill in. Never commit the real .env. Make random values with:
#   openssl rand -hex 32

# Required
DB_PASSWORD=change-me
JWT_SECRET=change-me
APP_PORT=5000

# School sign-in: the school site's login API, which returns
# {status: 'success', user: {..., roles: [...]}} for a right password.
# Leave both blank until it is live; the app then uses its own accounts.
SCHOOL_AUTH_URL=
# Sent as "Authorization: Bearer <key>"; the same value as
# EDUPYRAMIDS_API_KEY on the school site
SCHOOL_AUTH_API_KEY=

# Optional: a Google AI Studio key for the AI question generator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave blank on the real server (true adds demo accounts and classes)
SEED_DEMO_DATA=
