# Copy to .env next to docker-compose.yml. Never commit the real .env.
DB_PASSWORD=change-me
JWT_SECRET=a-long-random-string
APP_PORT=5000
# Optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# EduPyramids login API, from the client's tech team (Mrs. Ankita Singhal).
# Expects POST {email, password} -> {status: 'success', user: {..., role}}.
SCHOOL_AUTH_URL=
# Sent as "Authorization: Bearer <key>" to the login API, if they require one
SCHOOL_AUTH_API_KEY=
# true only for a demo server: adds four synthetic classes
SEED_DEMO_DATA=
